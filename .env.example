# Mobileum Renewals Intelligence — Environment Variables
# Copy this file to .env and fill in values.

# --- Database ---
DATABASE_URL=sqlite:///renewals.db

# --- AI Provider ---
# Set AI_PROVIDER to one of: demo | gemini | openai | custom
# "demo" requires no API key and answers from analytics data.
AI_PROVIDER=demo
AI_BASE_URL=
AI_MODEL_NAME=
AI_API_KEY=

# --- App ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
